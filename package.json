{
    "name": "personal-discord-bot",
    "type": "module",
    "version": "0.1.0",
    "private": true,
    "engines": {
        "node": "^24.22.1"
    },
    "scripts": {
        "dev": "seedcord dev",
        "build": "seedcord build",
        "start": "node --enable-source-maps dist/index.mjs",
        "codegen": "seedcord codegen",
        "lint": "eslint 'src/**/*.ts' --cache",
        "lint:fix": "eslint 'src/**/*.ts' --fix --cache",
        "fmt": "prettier --write 'src/**/*.{ts,json,md}' --cache",
        "fmt:check": "prettier --check 'src/**/*.{ts,json,md}' --cache",
        "tc": "tsc --noEmit"
    },
    "dependencies": {
        "@discordjs/builders": "^1.14.1",
        "@seedcord/gateway": "^0.8.0",
        "db0": "^0.4.1",
        "discord.js": "^14.27.0",
        "envapt": "^9.2.0",
        "seedcord-plugin-db0": "^1.3.0",
        "seedcord-plugin-unstorage": "^1.3.0",
        "unstorage": "^1.17.5",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@content-collections/cli": "^0.1.9",
        "@content-collections/core": "^0.15.3",
        "@content-collections/vite": "^0.3.1",
        "@seedcord/eslint-config": "^3.0.0",
        "@seedcord/tsconfig": "^3.0.0",
        "@types/node": "^26.6.2",
        "jiti": "^2.7.0",
        "prettier": "^3.9.9",
        "seedcord": "^0.22.0",
        "typescript": "~6.0"
    }
}
