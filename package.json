{
    "name": "personal-discord-bot",
    "type": "module",
    "version": "0.1.0",
    "private": true,
    "engines": {
        "node": ">=24.11"
    },
    "scripts": {
        "dev": "seedcord dev",
        "build": "seedcord build",
        "start": "node --enable-source-maps dist/index.mjs",
        "codegen": "seedcord codegen",
        "lint": "eslint 'src/**/*.ts' --cache",
        "lint:fix": "eslint 'src/**/*.ts' --fix --cache",
        "fmt": "prettier --write 'src/**/*.{ts,json,md}' --cache",
        "fmt:check": "prettier --check 'src/**/*.{ts,json,md}' --cache",
        "tc": "tsc --noEmit"
    },
    "dependencies": {
        "@discordjs/builders": "^1.14.1",
        "@seedcord/gateway": "^0.7.0",
        "discord.js": "^14.27.0",
        "envapt": "^8.2.3",
        "seedcord-plugin-unstorage": "^1.2.0",
        "unstorage": "^1.17.5"
    },
    "devDependencies": {
        "@seedcord/eslint-config": "^2.2.1",
        "@seedcord/tsconfig": "^2.0.3",
        "@types/node": "^26.6.2",
        "jiti": "^2.7.0",
        "prettier": "^3.9.9",
        "seedcord": "^0.21.0",
        "typescript": "~6.0"
    }
}
